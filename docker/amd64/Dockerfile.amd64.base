# syntax=docker/dockerfile:1
# BTick BASE image for amd64: ROS 2 Jazzy + Python bridge dependencies.
# Heavy and rarely changing. Built ONCE by the "Base Image" workflow and published
# as ghcr.io/<owner>/btick-base:<image_tag_version> (default tag: base).
# The app image (Dockerfile.amd64) builds on top of it, so UI / bridge changes
# never rebuild this layer.
#
# Local build:  docker build -f Dockerfile.amd64.base -t btick-base:local .

FROM ros:jazzy-ros-core

LABEL description="BTick base: ROS 2 Jazzy + Python bridge dependencies"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-zmq \
    python3-yaml \
    python3-msgpack \
    ros-jazzy-rclpy \
    ros-jazzy-std-msgs \
    ros-jazzy-nav2-msgs \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-rmw-fastrtps-cpp \
    curl \
    && rm -rf /var/lib/apt/lists/*

# amd64-specific packages/settings go here (leave empty if none)

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV ROS_DOMAIN_ID=0
